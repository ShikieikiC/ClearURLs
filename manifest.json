{
  "manifest_version": 3,
  "name": "ClearURLs Lite",
  "version": "1.0.0",
  "description": "Removes tracking elements from URLs. MV3 port of ClearURLs rules.",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "clearurls",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClearURLs Lite"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
